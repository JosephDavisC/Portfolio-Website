# ============================
# SECURITY HEADERS
# ============================

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.jsdelivr.net https://cdn.joechamdani.com https://www.googletagmanager.com https://www.google-analytics.com; font-src 'self'; media-src 'self' https://cdn.joechamdani.com; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com; frame-src 'self' https://www.youtube.com https://drive.google.com https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ============================
# PERFORMANCE OPTIMIZATIONS
# ============================

# Enable Gzip/Brotli compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On

  # Images - 1 year cache
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts - 1 year cache
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # CSS and JS - 1 year (Vite adds hash to filenames)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # HTML - no cache (always fresh)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Cache-Control headers
<IfModule mod_headers.c>
  # Hashed assets (immutable)
  <FilesMatch "\.(js|css|woff2|woff|jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML files - no cache
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ============================
# NOINDEX FOR /v1/ (old portfolio archive)
# ============================
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/v1/#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# ============================
# NOINDEX FOR /info498* (class projects, not for indexing)
# ============================
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/info498#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# ============================
# URL REWRITING
# ============================

# Enable rewrite engine
RewriteEngine On
RewriteBase /

# ============================
# ARCHIVED STATIC SITES
# ============================
# info498, info498resonance and the-path-growth were relocated under
# /archive/ to declutter the web root. Their assets use absolute paths and
# the-path-growth is tied to the /the-path-growth React route, so the public
# URLs must stay identical. These rules serve them from /archive/ internally
# (no visible redirect, so all original links keep working).

# info498resonance (match before info498 to avoid prefix collisions)
RewriteRule ^info498resonance/?$ /archive/info498resonance/index.html [L]
RewriteRule ^info498resonance/(.+)$ /archive/info498resonance/$1 [L]

# info498
RewriteRule ^info498/?$ /archive/info498/index.html [L]
RewriteRule ^info498/(.+)$ /archive/info498/$1 [L]

# the-path-growth (loader page + pdf-preview.html). Only rewrite sub-paths that
# exist as real files in the archive, so React routes like /the-path-growth/v1
# still fall through to the SPA below.
RewriteRule ^the-path-growth/?$ /archive/the-path-growth/index.html [L]
RewriteCond %{DOCUMENT_ROOT}/archive/the-path-growth/$1 -f
RewriteRule ^the-path-growth/(.+)$ /archive/the-path-growth/$1 [L]

# ============================
# WEBP IMAGE SERVING
# ============================
# Serve WebP images when browser supports it (SEO-safe migration)
# Original JPEG/PNG files are kept for Google Image indexing

# Add MIME type for WebP
AddType image/webp .webp

# If browser accepts WebP and WebP version exists, serve it
<IfModule mod_rewrite.c>
  # Check if browser supports WebP
  RewriteCond %{HTTP_ACCEPT} image/webp
  # Match requests for jpg, jpeg, or png
  RewriteCond %{REQUEST_URI} \.(jpe?g|png)$ [NC]
  # Check if WebP version exists
  RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
  # Rewrite to WebP
  RewriteRule ^(.+)\.(jpe?g|png)$ $1.webp [T=image/webp,L]
</IfModule>

# Set Vary header for proper caching (important for CDNs)
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png)$">
    Header append Vary Accept
  </FilesMatch>
</IfModule>

# ============================
# 301 REDIRECTS: Old portfolio URLs → /v1/ (noindexed)
# ============================
# Google still crawls these old paths. Redirect to /v1/ so they
# hit the noindex header above and eventually drop from the index.

RewriteRule ^blog-nxc/?$ /v1/blog-nxc [R=301,L]
RewriteRule ^portfolio-page/?$ /v1/portfolio-page [R=301,L]
RewriteRule ^portfolio-NXC/?$ /v1/portfolio-NXC [R=301,L]
RewriteRule ^portfolio-UI-UX-Bootcamp/?$ /v1/portfolio-UI-UX-Bootcamp [R=301,L]
RewriteRule ^portfolio-Binus/?$ /v1/portfolio-Binus [R=301,L]
RewriteRule ^portfolio-NXPLOLER/?$ /v1/portfolio-NXPLOLER [R=301,L]
RewriteRule ^portfolio-hsmun/?$ /v1/portfolio-hsmun [R=301,L]
RewriteRule ^portfolio-bctech/?$ /v1/portfolio-bctech [R=301,L]
RewriteRule ^portfolio-unity/?$ /v1/portfolio-unity [R=301,L]
RewriteRule ^portfolio-devnet/?$ /v1/portfolio-devnet [R=301,L]
RewriteRule ^portfolio-dinomarine/?$ /v1/portfolio-dinomarine [R=301,L]
RewriteRule ^portfolio-aligned/?$ /v1/portfolio-aligned [R=301,L]
RewriteRule ^inner-page/?$ /v1/inner-page [R=301,L]

# ============================
# PAGE ROUTING
# ============================

# /v1/ old portfolio: append .html if the file exists
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^v1/(.+)$ /v1/$1.html [L]

# Serve static blog pages ONLY for social media crawlers
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|WhatsApp|TelegramBot|Discordbot) [NC]
RewriteRule ^blog/bc-hacks-2024/?$ /blog/bc-hacks-2024/index.html [L]

# For all other requests (real users), serve the React SPA
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
